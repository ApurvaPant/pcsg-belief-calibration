# ─── Python ──────────────────────────────────────────────────────────────
backend/.venv/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/
.ipynb_checkpoints/

# ─── SQLite (app + experiment DBs) ───────────────────────────────────────
backend/*.db
backend/*.db-wal
backend/*.db-shm
*.sqlite
*.sqlite3

# ─── Env / secrets (keep .env.example tracked) ───────────────────────────
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# ─── Node / frontend ─────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.local
node_modules/

# ─── Models / dataset caches (downloaded, reproducible) ──────────────────
# Hugging Face hub + sentence-transformers caches live outside the repo
# (~/.cache/huggingface) but ignore any local copies too.
.cache/huggingface/
**/huggingface/
*.safetensors
*.bin.lock

# ─── Research artifacts (large / regenerated from configs + cache) ───────
backend/eval_results/
backend/results/
backend/.llm_cache/
backend/datasets/
# Experiment run outputs (regenerated by pcsg.run / make_figures). The curated
# headline artefacts under results/ (dashboard.json, figures/, tables/,
# RESULTS_SUMMARY.md, consistency/) stay tracked; only machine-generated run
# directories are ignored.
results/runs/
results/dryrun/
results/pilot/
results/datasets/
results/robustness/
# Human-review exports are generated; keep them out of version control.
backend/pcsg/datagen/verify_sample.csv
backend/eval/judge_check.csv

# ─── Logs ────────────────────────────────────────────────────────────────
*.log
frontend/*.log
backend/*.out.log

# ─── Editor / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
