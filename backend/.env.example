# Copy to .env and fill in. With LLM_PROVIDER=mock (default) the backend runs
# fully offline — no network, no key — and the whole test-suite passes.

# Provider: mock | openrouter | openai
LLM_PROVIDER=mock

# --- OpenRouter (OpenAI-compatible; no vendor SDK, plain httpx) -------------
# Set these when LLM_PROVIDER=openrouter:
OPENROUTER_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# For plain OpenAI instead:  LLM_PROVIDER=openai, OPENAI_API_KEY=..., OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Optional per-role model overrides (else config.yaml:llm.models is used)
# LLM_MODEL_CHAT=openai/gpt-4o-mini-2024-07-18
# LLM_MODEL_CLASSIFIER=meta-llama/llama-3.1-8b-instruct
# LLM_MODEL_EXTRACTOR=openai/gpt-oss-20b
# LLM_MODEL_EMBEDDING=openai/text-embedding-3-small

# Optional: label sent to OpenRouter for dashboard attribution
# OPENROUTER_APP_TITLE=User-State Graph Chat

# Optional SQLite path override (else config.yaml:storage.db_path)
# DB_PATH=userstate.db
